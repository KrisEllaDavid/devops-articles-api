# Copy this file to `.env` and adjust the values:  cp .env.example .env
# `.env` is git-ignored — never commit real credentials.

# HTTP port the API listens on
PORT=3000

# PostgreSQL connection
# - Running the API directly on your machine (npm start): DB_HOST=localhost
# - Running with docker compose: DB_HOST is overridden to `db` automatically
DB_HOST=localhost
DB_PORT=5432
DB_NAME=articles_db
DB_USER=article
DB_PASSWORD=change-me
